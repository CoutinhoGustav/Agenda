{
  "expo": {
    "name": "Agenda Inteligente",
    "slug": "agenda-inteligente",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "barStyle": "dark-content",
      "backgroundColor": "#00000000"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "android": {
      "package": "com.agendainteligente.app",
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.agendainteligente.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "defaultChannel": "lembretes",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f7620d8d-33a6-4e5b-8f24-08e83b515933"
      }
    }
  }
}